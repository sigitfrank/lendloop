# Next.js (.env.local). Copy this file to .env.local and fill in the values.

# Written automatically by `pnpm convex dev`
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# Clerk dashboard → API keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Written automatically by `pnpm mcp:setup` (base64 PEM; signs the MCP route's tokens for Convex)
MCP_JWT_PRIVATE_KEY=

# Set in Convex (dashboard → Settings → Environment Variables, or the scripts), NOT here:
# CLERK_JWT_ISSUER_DOMAIN = Clerk "Frontend API URL", e.g. https://<name>.clerk.accounts.dev
# LENDLOOP_HMAC_SECRET    = set by `pnpm n8n:setup`
# N8N_WEBHOOK_URL         = set by `pnpm tunnel`
# MCP_JWKS                = set by `pnpm mcp:setup` (public key)
