# n8n container environment (docker-compose.yml). Create the real file with:
#   pnpm n8n:setup
# which generates the secret, stores it in Convex too, and writes n8n.env.
# n8n.env is git-ignored. Never commit real values.

# Shared HMAC secret; must equal LENDLOOP_HMAC_SECRET in the Convex deployment.
LENDLOOP_HMAC_SECRET=

# Convex HTTP actions URL (NEXT_PUBLIC_CONVEX_SITE_URL in .env.local),
# e.g. https://<deployment>.convex.site
LENDLOOP_CONVEX_URL=

# Where the Next.js app runs; used for links in notification emails.
# Set with: pnpm n8n:setup --app-url http://localhost:3001
LENDLOOP_APP_URL=http://localhost:3000
