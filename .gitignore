# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (examples without values are committed)
.env*
!.env.example
# n8n settings and the HMAC secret (the .env* rule above doesn't match these)
n8n.env
.n8n-hmac-secret
!n8n.env.example

# private working notes
plan.md

# local AI agent tooling (installed by `convex ai-files`)
.agents/
.claude/skills/
skills-lock.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Video studio and plan (local only)
.idea/
