    {
      "id": "9e45190a-2d15-49e8-a859-43a7ae4a8d69",
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function signed(method, path, body) {\n  const timestamp = String(Math.floor(Date.now() / 1000));\n  return { method, path, body, timestamp, toSign: `${timestamp}.${method}.${path}.${body}` };\n}\nconst m = $('Compose email').first().json;\nconst detail = String($input.first().json.error?.message ?? 'Email could not be sent').slice(0, 500);\nconst body = JSON.stringify({ idempotencyKey: m.idempotencyKey, loanId: m.loanId, status: 'failed', detail });\nreturn [{ json: signed('POST', '/n8n/notification-status', body) }];"
      },
