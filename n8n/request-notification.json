    {
      "id": "75c4856b-35f6-40fc-a722-5f3d914b05e1",
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Only the fields this email needs: recipient, tool, dates, first names.\nconst e = $('Prepare: already sent?').first().json.event;\nconst day = (iso) => new Date(iso + 'T00:00:00Z').toLocaleDateString('en-GB', { day: 'numeric', month: 'short', timeZone: 'UTC' });\nconst dates = `${day(e.loan.startDate)} – ${day(e.loan.endDate)}`;\nconst who = e.otherPartyFirstName;\nconst copy = {\n  pending:   [`${who} wants to borrow your ${e.toolName}`, `${who} asked to borrow your ${e.toolName} for ${dates}. Approve or decline the request:`, '/my/incoming?status=pending'],\n  cancelled: [`${who} cancelled their request`, `${who} cancelled their request to borrow your ${e.toolName} (${dates}).`, '/my/incoming'],\n  approved:  [`${who} approved your request`, `Good news: ${who} approved your request to borrow the ${e.toolName} for ${dates}.`, '/my/requests'],\n  declined:  [`Your request for the ${e.toolName} was declined`, `Your request to borrow the ${e.toolName} for ${dates} was declined.`, '/my/requests'],\n  returned:  [`Thanks for returning the ${e.toolName}`, `${who} marked the ${e.toolName} as returned. Thanks for borrowing responsibly.`, '/my/requests'],\n}[e.status];\nreturn [{\n  json: {\n    to: e.recipient.email,\n    subject: copy[0],\n    text: `Hi ${e.recipient.firstName},\\n\\n${copy[1]}`,\n    linkPath: copy[2],\n    idempotencyKey: e.idempotencyKey,\n    loanId: e.loan.id,\n  },\n}];"
      },
      "name": "Compose email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2200, 300]
