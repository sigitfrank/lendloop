    {
      "id": "1367d5e8-2c20-4ef3-aac3-e5ec5a0c06e2",
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function signed(method, path, body) {\n  const timestamp = String(Math.floor(Date.now() / 1000));\n  return { method, path, body, timestamp, toSign: `${timestamp}.${method}.${path}.${body}` };\n}\nconst m = $('Compose email').first().json;\nconst body = JSON.stringify({ idempotencyKey: m.idempotencyKey, loanId: m.loanId, status: 'sent' });\nreturn [{ json: signed('POST', '/n8n/notification-status', body) }];"
      },
      "name": "Prepare write-back: sent",
