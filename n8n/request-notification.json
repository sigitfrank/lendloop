    {
      "id": "2c068eed-e6a0-4b93-a84e-fa4ece89c369",
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Rebuild exactly what Convex signed: \"{timestamp}.POST.{path}.{rawBody}\".\n// The Webhook node's Raw Body option keeps the request bytes (binary \"data\"),\n// so the signature is checked against what Convex actually sent, and the event\n// is parsed from those same bytes. Missing or unparsable body: fails the check.\nconst item = $input.first();\nconst headers = item.json.headers ?? {};\nconst timestamp = headers['x-lendloop-timestamp'] ?? '';\nconst raw = item.binary?.data\n  ? (await this.helpers.getBinaryDataBuffer(0, 'data')).toString('utf8')\n  : '';\nlet event = null;\ntry {\n  event = JSON.parse(raw);\n} catch {\n  event = null;\n}\nreturn [{\n  json: {\n    event,\n    timestamp,\n    receivedSignature: (headers['x-lendloop-signature'] ?? '').toLowerCase(),\n    toSign: `${timestamp}.POST./webhook/lendloop-loan-events.${raw}`,\n  },\n}];"
      },
      "name": "Build string to verify",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 300]
    },
    {
      "id": "dacb7ac4-4517-4eb7-9ccd-3f5a3b6dc7cc",
      "parameters": {
        "action": "hmac",
        "type": "SHA256",
        "value": "={{ $json.toSign }}",
        "dataPropertyName": "signature",
        "encoding": "hex"
      },
      "name": "Expected signature",
      "type": "n8n-nodes-base.crypto",
      "typeVersion": 2,
      "position": [440, 300],
      "credentials": {
        "crypto": {
          "id": "lendloopHmacSecret",
          "name": "LendLoop HMAC secret"
        }
      }
    },
    {
      "id": "72cc3381-9d79-454d-a356-4f39e034ed22",
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Constant-time comparison + 5-minute replay window.\nfunction safeEqual(a, b) {\n  if (typeof a !== 'string' || typeof b !== 'string' || a.length !== b.length) return false;\n  let diff = 0;\n  for (let i = 0; i < a.length; i++) diff |= a.charCodeAt(i) ^ b.charCodeAt(i);\n  return diff === 0;\n}\nconst item = $input.first().json;\nconst age = Math.abs(Math.floor(Date.now() / 1000) - Number(item.timestamp));\nconst valid = safeEqual(item.signature, item.receivedSignature) && Number.isFinite(age) && age <= 300;\nreturn [{ json: { valid, event: item.event } }];"
      },
      "name": "Check signature",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [660, 300]
    },
