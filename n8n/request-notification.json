    {
      "id": "d485a283-9fda-417e-9b87-1d71ad82055c",
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function signed(method, path, body) {\n  const timestamp = String(Math.floor(Date.now() / 1000));\n  return { method, path, body, timestamp, toSign: `${timestamp}.${method}.${path}.${body}` };\n}\n// Convex may re-deliver an event (at-least-once). Ask whether this\n// notification was already sent, so the email goes out only once.\nconst event = $input.first().json.event;\nconst path = '/n8n/event-status?key=' + encodeURIComponent(event.idempotencyKey);\nreturn [{ json: { event, ...signed('GET', path, '') } }];"
      },
      "name": "Prepare: already sent?",
